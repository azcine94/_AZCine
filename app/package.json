{
  "name": "azcine-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/run-desktop.mjs dev",
    "dev:web": "vite --configLoader runner --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc --noEmit && vite build --configLoader runner",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "engines": { "node": ">=24.18.0 <25" }
}
