{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AZCine",
  "version": "0.0.0",
  "identifier": "com.azcine.workbench",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AZCine · 本地开发版",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 768,
      "center": true,
      "decorations": true,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
