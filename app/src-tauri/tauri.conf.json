{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AZCine",
  "version": "0.1.2",
  "identifier": "com.azcine.workbench.release",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AZCine",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "maximized": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://goodcase.ai https://media.goodcase.ai; media-src 'self' blob: https://goodcase.ai https://media.goodcase.ai; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 https://datasets-server.huggingface.co https://models.dev https://aihot.news; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/runtime/pi-1.0.4-node-24.21.0/": "runtime/pi-1.0.4-node-24.21.0/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/azcine94/_AZCine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMzJCREEyMjVERTA4QjAKUldTd0NONGxvcjB5VWFOSDdPMWVVZjhmcEJsaU1oSkhyQlBWbTZXM3JRcVlZdEpDaWNqUDBGYVUK"
    }
  }
}
